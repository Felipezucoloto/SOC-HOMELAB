<!--
  DET-001 — Multiple authentication failures from the same source (brute force)
  MITRE ATT&CK: T1110 (Brute Force)
  Target file on the manager: /var/ossec/etc/rules/local_rules.xml
  Tested: 2026-11-26 — result: Detected

  v2: version 1 relied on <if_matched_sid>60122</if_matched_sid>.
  This version counts any event in the authentication_failed group,
  so it does not depend on the rule.id of a specific Wazuh version.
-->
<group name="local,windows,authentication,">

  <rule id="100100" level="10" frequency="8" timeframe="120">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Multiple Windows logon failures from the same source (possible brute force)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
